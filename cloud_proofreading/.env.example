# ----------------------------------------
# 🌐 Domain & HTTPS Configuration
# ----------------------------------------
# The public IP address of your physical server or VM (e.g., 34.2.1.5)
# We will use nip.io to automatically generate a valid HTTPS certificate.
SERVER_IP=1.2.3.4

# ----------------------------------------
# 🔐 Google OAuth2 Configuration
# ----------------------------------------
# 1. Go to Google Cloud Console -> APIs & Services -> Credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Set "Authorized redirect URIs" to: https://<your-server-ip>.nip.io/oauth2/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Security Cookie Secret 
# Generate using: python -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
COOKIE_SECRET=replace_me_with_base64_string

# -----------------------------------------------------------------------------
# D. INPUT FILE CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# If you want to automatically open specific files in the Unified Viewer when 
# you log in, specify their paths here. These paths must be relative to the 
# directory you mounted as DATA_DIR above. 
# For example, if you mounted './data' and have 'data/my_image.tif', you would use '/data/my_image.tif'.
# If you leave these blank, the viewer will open blank and you can drag-and-drop.
INPUT_RAW=/data/my_raw_volume.tif
INPUT_SKELETONS=/data/neurites.swc      # Or .json
INPUT_CENTROIDS=/data/centroids.swc     # Or .json


# ----------------------------------------
# 📁 Data Volumes & Docker
# ----------------------------------------
# Mount the host data directory into the container
DATA_DIR=/path/to/your/tiff/folder

# Your DockerHub Username for publishing/pulling
DOCKERHUB_USERNAME=yourusername
